《《lua异常处理》》
《《require "import"
import "android.app.*"
import "android.os.*"
import "android.widget.*"
import "android.view.*"
--lua有两个函数可以捕获异常
--pcall(fun[,arg1,...])
--xpcall(fun,errfun,[,arg1,...])

--对比两个函数,xpcall多了异常处理

function add(a,b)

  a = a+b

  return a

end


--正常调用
print(add(1,3))


p=2


function err()
  print("不能相加")
end


--安全调用,若出现异常,则会调用err函数,程序不会崩溃,继续执行下面的代码
xpcall(add,err,1,p)


print("==========")

local fun=function()
  import"lg"
end

xpcall(fun,
function(e)
  print("报错:\n"..e)
end
)

--方法二


--错误监听
local fun=function()
  import"lg"
end
--监听结束

--错误事件
tryCatch=function(fun)
  local ret,errMessage=pcall(fun);
  错误=ret and "false" or "true"
  --print("是否错误:\n"..错误.." \n\n出错信息:\n" .. (errMessage or "无"));

  if 错误=="true" then--错误提示
    local ret,errMessage=pcall(fun)
    print("\n错误详情：\n"..errMessage)
   else--无错误正常执行
    print("没有错误发生")
  end

end

tryCatch(fun)--调用错误
