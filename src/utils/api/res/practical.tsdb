file={}--文件操作
--检查文件
function file.check(path)
  local file=io.open(path,"r")
  if not file then
    return false
  else
    file:close()
    return true
  end
end

--写入文件
function file.write(path,string)
  import "java.io.File"
  local file = File(tostring(path))
  file.getParentFile().mkdirs()
  local open = io.open(tostring(path),"w")
  local open = open:write(tostring(string))
  local open = open:close()
  return true
end


--字符常量
APP_PACKAGENAME=activity.getPackageName()
APP_CACHEPATH=tostring(activity.getExternalCacheDir())


--代码查错
function codecheck(code)
  src=tostring(code)
  local _,data=loadstring(src)
  if data then
    local _,_,line,data=data:find(".(%d+).(.+)")
    editor.gotoLine(tonumber(line))
    toast("代码出错："..line.."：".. data)
  else
    return true
  end
end


local funcs={
  线性布局="LinearLayout",文本控件="TextView",
  导包="require",引用="import",函数="function",
  如果="if",那么="then",大于=">",
  小于="<",等于="==",否则="else",
  结束="end",打印="print",加载布局="loadlayout",
  否则如果="elseif",返回="return",设置视图内容="setContentView",
  真="true",假="false",活动="activity",
}


--运行代码
function runcode(code)
  for key, value in pairs(funcs) do
    code = string.gsub(code,key, value)
  end

  if codecheck(code) then
    file.write(APP_CACHEPATH.."/test.lua",code)
    activity.newActivity(APP_CACHEPATH.."/test.lua")
  end
end


