function 月份()
  年份()
end

function 年份()
  年底.setText(os.date("%Y年-%m月-%d日-星期%w"))--获取当前系统时间
end

function 刷新()
  require "import"
  while true do--执行循环命令
    Thread.sleep(100)--延迟执行
    call("月份")
  end
end

thread(刷新)--运行线程,循环刷新时间






--本地系统时间
function 时间()
  时间秒()
end

function 时间秒()
  时分秒.setText(os.date("%H时:%M分:%S秒"))--获取当前系统时间
end

function 刷新()
  require "import"
  while true do--执行循环命令
    Thread.sleep(100)--延迟执行
    call("时间")
  end
end

thread(刷新)--运行线程,循环刷新时间
