local adp=LuaArrayAdapter(this,item)
list.Adapter=adp
Pulling.onRefresh=function(v)
  task(3000,function()--设置三秒后执行
    adp.clear()
    if m==0 then --如果m=0为真时
      m=10--创建一个全局变量
    end
    for n=1,m do--因为m变量存贮的值是10循所以环十次
      adp.add("下拉刷新测试"..n)--添加一项
    end  
    v.refreshFinish(0)
    --[[括号里面的数字0为刷新成功！
    1为刷新失败
    2为没有更新的容的提示
    2以后都为加载失败
    上拉加载与下拉刷新使用方法相同！]]
  end )
end
m=10--全局变量

--上拉加载
Pulling.onLoadMore=function(v)
  task(3000,function()--设置三秒后执行
    for n=0,10 do   --循环10次即为添加10项内容
      adp.add("下拉刷新测试"..n)--添加一项
    end
    v.loadmoreFinish(0)--刷新成功
  end )
end


