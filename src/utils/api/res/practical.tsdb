Bubbles7.setCustomSectionTextArray({
 onCustomize=function( sectionCount, array)
  array.clear();--设置在那个点下面显示哪个文字
  array.put(1, "bad");
  array.put(4, "ok");
  array.put(7, "good");
  array.put(9, "great");
  return array;
 end
});

--监听回调
Bubbles7.setOnProgressChangedListener({
 onProgressChanged=function( bubbleSeekBar, progress, progressFloat, fromUser)
  if progress <= 10
   color = 0xFFF44336
   elseif progress <= 40
   color = 0xFFE57373
   elseif progress <= 70
   color = 0xFF9C27B0
   elseif progress <= 90
   color = 0xFF00BCD4
   else
   color = 0xFF4CAF50
  end
  bubbleSeekBar.setSecondTrackColor(color);
  bubbleSeekBar.setThumbColor(color);
  bubbleSeekBar.setBubbleColor(color);
 end})


Bubbles8.getConfigBuilder()
.max(10)
