task(100,function()
  --设置揭露动画，对于参数为(ID,动画圆心X轴，动画圆心Y轴,动画开始时半径,动画结束时半径)
  揭露动画 = ViewAnimationUtils.createCircularReveal(卡片,0,0,300,0)
  揭露动画.setDuration(5000)--设置动画时间
  揭露动画.start()--开始动画
end)》》


