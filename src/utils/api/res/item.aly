{
  LinearLayout;
  orientation="vertical";
  layout_height="fill";
  layout_width="fill";
  {
    LinearLayout;
    layout_width="fill";
    layout_height="52dp";
    {
      ImageView;
      id="item_图标";
      layout_height="52dp";
      layout_width="52dp";
      src=nil;
      padding="13dp";
    };
    {
      TextView;
      id="item_排头";
      gravity=17;
      layout_height="fill";
      layout_width="10dp";
      text="";
      textSize="15sp";
     -- layout_marginLeft="12dp";
     -- layout_marginRight="12dp";
      textColor=0xffffffff;
      visibility=8;
    };
    {
      LinearLayout;
      gravity="left|center";
      layout_height="fill";
      layout_width="fill";
      orientation="vertical";
      {
        TextView;
        id="item_名称";
        gravity="bottom";
        text="文件名";
        maxLines=1;
        ellipsize="end";
        textSize="15sp";
        layout_marginRight="16dp";
        textColor=0xffffffff;
      };
      {
        TextView;
        id="item_大小";
        layout_gravity="left";
        text="0 KB";
        textSize="10sp";
        gravity="left";
        maxLines=2;
        ellipsize="end";
        layout_marginRight="16dp";
        
      };
    };
  };
  {
    TextView;
    id="item_分割线";
    gravity="bottom";
    text="";
    textSize="0sp";
    layout_marginLeft="10dp";
    layout_height=2;
    layout_width="fill";
    backgroundColor=0x44ffffff;
    visibility=8;
  };
};