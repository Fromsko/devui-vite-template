《《控件变色》》
《《--安卓提供了7种控件的状态
states_res={
  android.R.attr.state_window_focused,--焦点在窗口,只有悬浮窗程序会发生窗口焦点变化
  android.R.attr.state_enabled,--控件处于可用状态
  android.R.attr.state_focused,--焦点在控件
  android.R.attr.state_pressed,--控件被按下
  android.R.attr.state_checked,--控件被check
  android.R.attr.state_checkable,--控件可选
  android.R.attr.state_selected,--控件被select
}
--前面加-表示非，例如-android.R.attr.state_enabled表示控件不可用状态
--不是所有控件都有7种状态的
--Button没有fucused状态
--而checked状态是CheckBox独有的
--这和控件实现的接口有关

--Clickable必须为true才能响应state_pressed

import "android.content.res.ColorStateList"
--如果控件同时存在多种状态，例如state_enabled和state_checked
--那么优先显示states中前面的状态对应的颜色
--为什么states必须是二维数组呢？因为安卓提供多个状态的组合判断

--ColorStateList方法第一个参数为包含状态资源的二维数组，第二个参数为对应的agrb代码
--下面是一些示例

tvBgStates={{android.R.attr.state_pressed}}
tvBgColor={0xFF2196F3}
tvTextStates={
  {android.R.attr.state_pressed},
  {-android.R.attr.state_pressed},
}
tvTextColor={0xffffffff,0xff000000}
tv.setTextColor(ColorStateList(tvTextStates,tvTextColor))
--setBackgroundTintList方法
--控件背景不能为空或者完全透明，否则无效果
tv.setBackgroundTintList(ColorStateList(tvBgStates,tvBgColor))


btnBgStates={
  {android.R.attr.state_pressed},
  {android.R.attr.state_enabled},
}
btnBgColor={0xFFF44336,0xFFCDDC39,}
btn.setBackgroundTintList(ColorStateList(btnBgStates,btnBgColor))


cbBgStates={
  {android.R.attr.state_checked},
  {-android.R.attr.state_checked},
}
cbBgColor={0xFFFF5722,0xFFFFFFFF}
cb.setBackgroundTintList(ColorStateList(cbBgStates,cbBgColor))


etBgStates={
  {android.R.attr.state_focused},
  {android.R.attr.state_enabled},
}
etBgColor={0xFFFF5722,0xFF00FFFF}
et.setBackgroundTintList(ColorStateList(etBgStates,etBgColor))


--RadioButton也用state_checked而不是state_selected
rbTextStates={
  {android.R.attr.state_checked},
  {-android.R.attr.state_checked},
}
rbTextColor={0xFF03A9F4,0xFF888888}
--如果是一样的显示效果，那么ColorStateList可以复用
rbTextColorList=ColorStateList(rbTextStates,rbTextColor)
rb1.setTextColor(rbTextColorList)
rb2.setTextColor(rbTextColorList)
rb3.setTextColor(rbTextColorList)
