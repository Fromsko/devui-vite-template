function bn1.onClick()
  if bt.isEnabled() then
    closebt()
    bn1.setText("开启蓝牙")
    bn1.setTextColor(0xff000000)
    bbtxt.setText(statebt())
  else
    openbt()
    bn1.setText("关闭蓝牙")
    bn1.setTextColor(0xffff0000)
    bbtxt.setText(statebt())
    end 
end

function btkj.onClick()
   local kj=Intent(bt.ACTION_REQUEST_DISCOVERABLE)
   --说好的申请3600秒呢？系统只给120秒！fuck !
   kj.putExtra(bt.EXTRA_DISCOVERABLE_DURATION,3600)
   activity.startActivity(kj)
end

function sao.onClick()
  --获取己配对的没备列表
  if bt.isDiscovering() then
    bbtxt.setText("蓝牙扫描己关闭。。")
    bt.cancelDiscovery()
    sao.setText("关闭扫描")
 else
    bbtxt.setText("蓝牙扫描己开启。。")
    bt.startDiscovery()
    sao.setText("开启扫描")
    listbt() 
  end
 end

function fuwuqi.onClick()
 --线程运用   
  if bt.isEnabled() then
   thread(fuwu,1)  
   print "己开服务器，等待客户连接！"
   else
   print"蓝牙未打开"
   end
end


function fuwu(txt)
  require "import"
  import "android.bluetooth.*"
  import "android.content.*"
  import "java.util.UUID"
  bt=BluetoothAdapter.getDefaultAdapter()
  local xt="fa87c0d0-afac-11de-8a39-0800200c9a66"
  local xy="00001101-0000-1000-8000-00805F9B34FB"

  local btbt=UUID.fromString(xy)
  
  serverSocket=bt.listenUsingRfcommWithServiceRecord("红米手机",btbt)
  socks=serverSocket.accept()
  
  if socks==nil then
     socks.close()
   else
   print("己连接一个设备")
   sockss=socks
   print(socks)
  end

while socks~=nil do
  if bt.isEnabled() then
    bttext=socks.getInputStream()
    bs=byte[1024]
    data=bttext.read(bs)
    print(tostring(String(bs)))
 else
  print"蓝牙未打开或己关闭"
  end  
end

  
end




