《《require "import"
import "android.app.*"
import "android.os.*"
import "android.widget.*"
import "android.view.*"

import "java.net.ServerSocket";

import "java.net.InetAddress"
import "java.net.SocketAddress"
import "java.net.InetSocketAddress"
import "java.io.OutputStreamWriter"
import "java.io.PrintWriter"
activity.setTitle('elua')
activity.setTheme(android.R.style.Theme_Holo_Light)
activity.setContentView(loadlayout({
  LinearLayout;
  layout_width="fill";
  layout_height="fill";
  orientation="vertical";
   {
    TextView;
    layout_width="fill";
    layout_margin="222";
    id="v";
    text="释放端口";
  };
  {
    TextView;
    layout_width="fill";
    layout_margin="222";
    id="vv";
    text="连接";
  };
  {
    TextView;
    layout_width="fill";
    layout_margin="222";
    id="vvv";
    text="发送信息。";
  };
  {
    TextView;
    layout_width="fill";
    layout_margin="222";
    id="vvvv";
    text="退出。";
  };
};
))
----------------接收--------------

function ai(a)
  vv.Text=a
  print(a)
end

function aa(a)
  require "import"
  import "java.io.BufferedReader"
  import "java.io.InputStreamReader"
  import "java.net.ServerSocket"
  pcall(function()ss = ServerSocket(22222)end)
  if not ss then
    a("端口被占用！")
    return
  end

  socket = ss.accept()
  a("已连接。")
  iin = socket.getInputStream();
  isr = InputStreamReader(iin, "UTF-8");
  br = BufferedReader(isr);
  while(true)
    Thread.sleep(500)
    xx= br.readLine()
    if xx then
      print(xx)
    end
  end
end



----------------发送--------------

function bi(a)
  out = a.getOutputStream();
  osw = OutputStreamWriter(out, "UTF-8");
  pw = PrintWriter(osw, true);
  vv.Text="已连接"
end

function bb(a)
  require "import"
  import "java.net.Socket";
  pcall(function() socket=Socket("127.0.0.1",22222)end);

  if socket then
    a(socket)
   else
    print"连接失败！"
  end
end

v.onClick=function()
  if pcall(function()ServerSocket(22222).close()end)then
    v.setEnabled(false)
    thread(aa,ai)
    v.Text="已释放，等待连接..."
    print"已释放，等待连接..."
   else
    print"端口被占用"
  end
end

vv.onClick=function()
  if vv.Text=="连接" then
    vv.Text="正在连接..."
    vv.setEnabled(false)
    thread(bb,bi)
    print"正在连接.."
   else
    print"端口被占用！"
  end
end


vvv.onClick=function()
  if pw then
    pw.println("你好，shiJie！" .. math.random(11111,22222));
   else
    print("未连接")
  end
end

vvvv.onClick=function()
  os.exit()
end



vvv.onTouch=function(a,b)
  switch b.getAction()
   case 1 vvv.BackgroundColor = 0x00000000
   case 2 vvv.BackgroundColor = 0xFF00E9FF
  end
end
