{
  LinearLayout;
  layout_width="fill";
  layout_height="fill";
  orientation="vertical";
  id="manual_底层";
  {
    LinearLayout;
    layout_width="fill";
    orientation="vertical";
    {
      LinearLayout;
      layout_width="fill";
      layout_height="40dp";
      orientation="vertical";
    };
    {
      LinearLayout;
      layout_width="fill";
      gravity="center";
      layout_height="56dp";
      orientation="horizontal";
      {
        TextView;
        layout_weight="1";
        text="代码手册";
        layout_marginLeft="20dp";
        layout_width="fill";
        id="manual_顶部标题";
        textSize="18sp";
        textColor="#FFFFFF";
      };

    };
  };
  {
    LinearLayout;
    layout_width="match_parent";
    orientation="vertical";
    id="manual_舞台";
    layout_height="match_parent";
    {
      LinearLayout;
      layout_weight="1";
      layout_width="match_parent";
      layout_height="match_parent";
      {
        GamePageView;
        id="manual_page";
        layout_width="match_parent";
        layout_height="match_parent";
        pages={
          {
            LinearLayout;
            layout_width="fill";
            orientation="vertical";
            layout_height="fill";
            padding="18dp";
            Focusable=true,
            FocusableInTouchMode=true,
            {
              EditText;
              id="manual_手册搜索";
              singleLine=true;
              layout_width="fill";
              hint="搜索关键词";
              gravity="center";
              layout_height="40dp";
              textSize="14sp";
              textColor="#ff0000";
              hintTextColor="#9e9e9e";
            };
            {
              LinearLayout;
              gravity="center";
              layout_marginTop="10dp";
              orientation="horizontal";
              layout_width="match_parent";
              {
                LinearLayout;
                orientation="horizontal";
                layout_width="wrap";
                layout_height="wrap";
                layout_marginLeft="10dp";
                id="manual_手册分类";
                gravity="center";
                {
                  ImageView;
                  id="manual_手册分类图标";
                  src="res/img/prog_lua02.png";
                  layout_height="20dp";
                  layout_width="20dp";
                };
                {
                  TextView;
                  text="全部";
                  textSize="12sp";
                  layout_marginLeft="5dp";
                  id="manual_手册分类文本";
                };
              };
              {
                TextView;
                text="共找到0条数据";
                textSize="11sp";
                id="manual_手册数据";
                layout_marginRight="10dp";
                layout_marginLeft="8dp";
                layout_weight="1";
                layout_width="match_parent";
              };
              {
                TextView;
                text="查看Lua参考手册";
                textSize="12sp";
                textColor="#000000";
                layout_marginLeft="5dp";
                id="manual_Lua参考手册";
              };
            };
            {
              PullingLayout;
              layout_marginTop="10dp";
              id="manual_手册下拉刷新";
              layout_width="fill";
              PullDownEnabled=true;
              {
                ListView;
                id="manual_手册列表";
                layout_marginLeft="0dp";
                layout_height="match_parent";
                layout_width="match_parent";
                VerticalScrollBarEnabled=false;
                DividerHeight="0dp";
              };
            };
          };
          {
            RelativeLayout;
            layout_height="match_parent";
            layout_width="match_parent";
            {
              LinearLayout;
              layout_width="fill";
              orientation="vertical";
              layout_height="fill";
              {
                LinearLayout;
                orientation="horizontal";
                layout_width="match_parent";
                layout_height="60dp";
                {
                  LinearLayout;
                  id="manual_返回列表";
                  layout_width="50dp";
                  orientation="vertical";
                  gravity="center";
                  layout_height="fill";
                  {
                    ImageView;
                    src="res/img/keyboard_arrow_left_black.png";
                    layout_width="35dp";
                    layout_height="35dp";
                    padding="0dp";
                    id="manual_返回列表图标";
                  };
                };
                {
                  TextView;
                  text="暂无标题";
                  textSize="14sp";
                  gravity="center";
                  maxLines=1;
                  ellipsize="end";
                  id="manual_代码标题";
                  layout_width="match_parent";
                  layout_height="match_parent";
                  layout_weight="1";
                  layout_marginLeft="20dp";
                  layout_marginRight="20dp";
                };
                {
                  LinearLayout;
                  id="manual_菜单";
                  layout_width="50dp";
                  orientation="vertical";
                  gravity="center";
                  layout_height="fill";
                  {
                    ImageView;
                    src="res/img/more.png";
                    layout_width="35dp";
                    layout_height="35dp";
                    padding="5dp";
                    id="manual_菜单图标";
                  };
                };
              };
              {
                LinearLayout;
                id="manual_代码编辑列表底层";
                orientation="horizontal";
                layout_width="match_parent";
                {
                  GridView;
                  gravity="center";
                  layout_width="fill",
                  layout_height="wrap",
                  numColumns=5;
                  id="manual_代码编辑列表";
                  visibility=8;
                };
              };
              {
                LuaEditor;
                layout_height="fill";
                layout_weight="1";
                text="";
                layout_width="-1";
                id="manual_edit";
              };
            };
          };
        };
      };
    };
  };
};
