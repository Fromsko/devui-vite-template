--自动主题
function switchtheme(pattern,layout)--主题模式(不填则自动)、布局表(aly文件路径或表)
  local h=tonumber(os.date("%H"))
  if Build.VERSION.SDK_INT >= 21 then
    if pattern == "白天" then
      this.setTheme(android.R.style.Theme_Material_Light_DarkActionBar)
      this.ActionBar.setBackgroundDrawable(ColorDrawable(Color.parseColor(themecolor.btl)))
      this.getWindow().addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS).setStatusBarColor(Color.parseColor(themecolor.ztl))
    elseif pattern == "夜间" then
      this.setTheme(android.R.style.Theme_Material)
    else
      if h<=6 or h>=22 then
        this.setTheme(android.R.style.Theme_Material)
      else
        this.setTheme(android.R.style.Theme_Material_Light_DarkActionBar)
        this.ActionBar.setBackgroundDrawable(ColorDrawable(Color.parseColor(themecolor.btl)))
        this.getWindow().addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS).setStatusBarColor(Color.parseColor(themecolor.ztl))
      end
      this.ActionBar.setElevation(6)
    end
  else
    if pattern == "白天" then
      this.setTheme(android.R.style.Theme_Holo_Light_DarkActionBar)
      this.ActionBar.setBackgroundDrawable(ColorDrawable(Color.parseColor(themecolor.btl)))
    elseif pattern == "夜间" then
      this.setTheme(android.R.style.Theme_Holo)
    else
      if h<=6 or h>=22 then
        this.setTheme(android.R.style.Theme_Holo)
      else
        this.setTheme(android.R.style.Theme_Holo_Light_DarkActionBar)
        this.ActionBar.setBackgroundDrawable(ColorDrawable(Color.parseColor(themecolor.btl)))
      end
    end
  end
  if layout~=nil then
    this.setContentView(loadlayout(layout))
  end
end
