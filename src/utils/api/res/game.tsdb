《《box2D物理引擎》》
《《PolygonDef类--多变形
density = 0--密度
friction = 0.8; -- 设置多边形的摩擦力
restitution = 0; -- 设置多边形的恢复力 弹力

CircleDef(); -- 实例一个圆形的皮肤
  density = 0; -- 初始圆形为静态
  friction = 0.8; -- 初始圆形的摩擦力
  restitution = 0.3; -- 初始圆形的恢复力
  radius = r / RATE; -- 初始圆形的半径

BodyDef(); -- 实例一个刚体对象
allowSleep 是否允许睡眠
angle--角
angularDamping--旋转速度调节 越大旋转越慢
fixedRotation--br是否固定物体使其不旋转
isBullet--br是否是子弹 高速移动物体请设置true 否则会碰撞失败
isSleeping--br是否为睡眠状态 设置初始为休眠状态 受力活动
linearDamping--线性阻尼
position--位置
massData--自定义物体数据
userData--自定义类

body 物体类
createShape(shape)--创建形状
destroyShape(shape)--破坏形状
setMass(mass)--设置质量
setMassFromShapes()
applyForce(Vec2(500,0),Vec2(0,0));--施加力 加速度力循序渐进
setXForm(Vec2(10,10),0)--设置坐标传送物体
getPosition--f 获取中心位置
getAngle()--f 获取旋转角
getWorldCenter()--返回vec2
getLocalCenter()--返回vec2
setLinearVelocity()--设置线性速度
getLinearVelocity()--返回vec2 获取线性速度
setAngularVelocity()--设置角速度
getAngularVelocity()--f 获取角速度
applyTorque(f)--施加扭矩
applyImpulse(vec2,vec2)--施加(力)新的速度与原有速度叠加
getMass() --f 获取质量
getInertia()--f 获得惯性
getWorldPoint(Vec2) --获取世界点
getWorldVector(Vec2)--获取世界矢量
getLocalPoint(Vec2)--获取局部点
getLocalVector(Vec2)--获取局部矢量
isBullet()--获取是否是子弹
setBullet()--设置为子弹
isStatic()--获取是否休眠
isDynamic()--获取是否是动态的 density为零返回false
isFrozen()--获取是否被冻结了
isSleeping()--获取睡眠状态
allowSleeping(boolean)--允许睡眠
wakeUp()--唤醒
getShapeList()--获取形状列表 调整形状参数
getJointList()--获取关节对象列表 调整关节参数
getNext()
getUserData()--获取自定义类
