bt1.onClick=function()
  --意图1（分享文本）
  import "android.content.Intent"
  intent1= Intent(Intent.ACTION_SEND)
  intent1.setType("text/plain")
  intent1.putExtra(Intent.EXTRA_SUBJECT,"测试")
  intent1.putExtra(Intent.EXTRA_TEXT, "测试")
