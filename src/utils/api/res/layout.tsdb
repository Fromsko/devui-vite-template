--获取音乐
local musicUrl
local mediaPlayer = MediaPlayer()
function get_music()
  Http.get("https://api.vvhan.com/api/rand.music?type=json&sort=热歌榜", nil, nil, nil, function(code, content, cookie, header)
    if code ~= 200 then
      return Toast.makeText(activity, "get错误\ncode:"..code.."\ncontent:"..content,Toast.LENGTH_SHORT).show()
    end
    local json = cjson.decode(content)
    if not json.success then
      return Toast.makeText(activity, "服务器错误\ncontent:"..content,Toast.LENGTH_SHORT).show()
    end
    music_name_output.text = cjson.encode(json.info.name)
    music_picture_output.loadUrl("data:text/html,<body style='margin:0;'><img src='"..json.info.picUrl.."' style='width:100px; height:100px;' /></body>")
    mediaPlayer.reset() --初始化参数
    mediaPlayer.setDataSource(json.info.mp3url) --设置播放资源
    mediaPlayer.prepare() --开始缓冲资源
    --缓冲完成的监听
    mediaPlayer.setOnPreparedListener(MediaPlayer.OnPreparedListener{
      onPrepared = function(mediaPlayer)
        mediaPlayer.start()
        print("缓冲完毕，开始播放")
      end
    });
    musicUrl = json.info.mp3url
  end)
end
music_next.onClick = get_music --下一首
music_download.onClick = function --下载
  local url = musicUrl
  local addr = "/sdcard/music("..os.date("%Y-%m-%d %H:%M:%S")..").mp3"
  Http.download(url, addr, nil, nil, function
    print("已下载至"..addr)
  end)
end
function onDestroy()
  mediaPlayer.stop()
end

--获取语音
function get_song()
  mediaPlayer.reset() --初始化参数
  mediaPlayer.setDataSource("https://api.vvhan.com/api/song?txt="..song_input.text) --设置播放资源
  mediaPlayer.prepare() --开始缓冲资源
  --缓冲完成的监听
  mediaPlayer.setOnPreparedListener(MediaPlayer.OnPreparedListener{
    onPrepared = function(mediaPlayer)
      mediaPlayer.start()
      print("缓冲完毕，开始播放")
    end
  });
end
song_play.onClick = get_song --播放
song_download.onClick = function --下载
  local url = "https://api.vvhan.com/api/song?txt="..song_input.text
  local addr = "/sdcard/song("..os.date("%Y-%m-%d %H:%M:%S")..").mp3"
  Http.download(url, addr, nil, nil, function
    print("已下载至"..addr)
  end)
end

--聊天机器人发送内容改变
chat_input.addTextChangedListener{
  onTextChanged = function(text, start, before, count)
    if chat_input.text == "" then return end --无输入
    Http.get("http://api.qingyunke.com/api.php?key=free&appid=0&msg="..urlEncode(chat_input.text), nil, nil, nil, function(code, content, cookie, header)
      if code ~= 200 then
        return Toast.makeText(activity, "get错误\ncode:"..code.."\ncontent:"..content,Toast.LENGTH_SHORT).show()
      end
      local json = cjson.decode(content)
      if json.result~=0 then
        return Toast.makeText(activity, "服务器错误\ncontent:"..content,Toast.LENGTH_SHORT).show()
      end
      chat_output.text = string.gsub( cjson.encode(json.content), "{br}", "\n" )
    end)
  end
}

