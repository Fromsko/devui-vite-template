activity.setTheme(android.R.style.Theme_DeviceDefault_Light)--设置md主题
activity.setTitle("API调用")
activity.setContentView(loadlayout(layout))


function urlEncode(s)
  s = string.gsub(s, "([^%w%.%- ])", function(c)
    return string.format("%%%02X", string.byte(c)) end)
  return string.gsub(s, " ", "+")
end
function urlDecode(s)
  s = string.gsub(s, '%%(%x%x)', function(h)
    return string.char(tonumber(h, 16)) end)
  return s
end


--二维码输入改变
QRcode_input.addTextChangedListener{
  onTextChanged = function(text, start, before, count)
    if QRcode_input.text == "" then return end --无输入
    QRcode_output.loadUrl("https://api.vvhan.com/api/qr?text="..urlEncode(QRcode_input.text))
  end
}
--二维码下载
QRcode_download.onClick = function
  Http.download("https://api.vvhan.com/api/qr?text="..urlEncode(QRcode_input.text), "/sdcard/QRcode.png", nil, nil, function
    print("已下载至/sdcard/QRcode.png")
  end)
end

--有道翻译改变
youDaoTranslate_input.addTextChangedListener{
  onTextChanged = function(text, start, before, count)
    if youDaoTranslate_input.text == "" then return end --无输入
    Http.get("http://fanyi.youdao.com/translate?doctype=json&type=AUTO&i="..urlEncode(youDaoTranslate_input.text), nil, nil, nil, function(code, content, cookie, header)
      if code ~= 200 then
        return Toast.makeText(activity, "get错误\ncode:"..code.."\ncontent:"..content,Toast.LENGTH_SHORT).show()
      end
      local json = cjson.decode(content)
      youDaoTranslate_output.text = json.translateResult[1][1].tgt
    end)
  end
}

--万能翻译改变
translate_input.addTextChangedListener{
  onTextChanged = function(text, start, before, count)
    if translate_input.text == "" then return end --无输入
    Http.get("https://api.vvhan.com/api/fy?text="..urlEncode(translate_input.text), nil, nil, nil, function(code, content, cookie, header)
      if code ~= 200 then
        return Toast.makeText(activity, "get错误\ncode:"..code.."\ncontent:"..content,Toast.LENGTH_SHORT).show()
      end
      local json = cjson.decode(content)
      if not json.success then
        return Toast.makeText(activity, "服务器错误\ncontent:"..content,Toast.LENGTH_SHORT).show()
      end
      translate_output.text = json.data.fanyi
    end)
  end
}

--获取一言
function get_yiYan()
  Http.get("https://api.vvhan.com/api/ian", nil, nil, nil, function(code, content, cookie, header)
    if code ~= 200 then
      return Toast.makeText(activity, "get错误\ncode:"..code.."\ncontent:"..content,Toast.LENGTH_SHORT).show()
    end
    yiYan_output.text = content
  end)
end
--get_yiYan()
yiYan_next.onClick = get_yiYan --下一句
yiYan_copy.onClick = function --复制
  activity.getSystemService(Context.CLIPBOARD_SERVICE).setText( yiYan_output.text )
  Toast.makeText(activity, "复制成功",Toast.LENGTH_SHORT).show()
end

