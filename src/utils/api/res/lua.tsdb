《《YLua中文函数库》》
《《--创建一个类
local YLua = {}
function YLua:new()
  local yswy = {}
  setmetatable(yswy, self)
  self.__index = self
  return yswy
end

--定义类的成员属性
YLua.当前脚本运行目录 = activity.getLuaDir()

YLua.屏幕宽度 = activity.getWidth()

YLua.屏幕高度 = activity.getHeight()


--定义类的方法
function YLua:获取脚本当前目录()
  return self.当前脚本运行目录
end



function YLua:写入剪切板(内容)
  import "android.content.Context"
  this.getSystemService(Context.CLIPBOARD_SERVICE).setText(tostring(内容))
end

function YLua:获取剪切板()
  import "android.content.Context"
  return this.getSystemService(Context.CLIPBOARD_SERVICE).getText()
end

function YLua:存储应用数据(key,value)
  activity.setSharedData(key,value)
  return true
end

function YLua:获取应用数据(key)
  local data = activity.getSharedData(key)
  return data
end

function YLua:存储全局变量(名称,内容)
  activity.getGlobalData()[名称]=内容
end

function YLua:获取全局变量(名称)
  return activity.getGlobalData()[名称]
end

function YLua:进入页面(名称,...)
  activity.newActivity(名称,...)
end

function YLua:退出页面()
  activity.finish()
end

function YLua:代码查错(内容)
  local status,error=pcall(loadstring(内容))
  if not status then
    print("代码有误：",error)
  end
end

function YLua:设置标题(内容)
  activity.setTitle(内容)
end

function YLua:设置小标题(内容)
  activity.getActionBar().setSubtitle(内容)
end

function YLua:URL编码(内容)
  import "java.net.URLEncoder"
  return URLEncoder.encode(内容)
end

function YLua:URL解码(内容)
  import "java.net.URLDecoder"
  return URLDecoder.decode(内容)
end

function YLua:be64编码(内容)
  local Base64=luajava.bindClass("android.util.Base64")
  return Base64.encodeToString(String(内容).getBytes(),Base64.NO_WRAP);
end

function YLua:be64解码(内容)
  local Base64=luajava.bindClass("android.util.Base64")
  return String(Base64.decode(内容,Base64.DEFAULT)).toString()
end

function YLua:获取网络状态()
  return activity.getApplicationContext().getSystemService(Context.CONNECTIVITY_SERVICE).getActiveNetworkInfo();
end

function YLua:新文件夹(path)
  import "java.io.File"
  return File(tostring(path)).mkdirs()
end

function YLua:新文件(path)
  import "java.io.File"
  return File(tostring(path)).createNewFile()
end

function YLua:是文件夹(path)
  import "java.io.File"
  return File(tostring(path)).isDirectory()
end

function YLua:是文件(path)
  import "java.io.File"
  return File(tostring(path)).isFile()
end


function YLua:删除文件夹(path)
  import "java.io.File"
  return LuaUtil.rmDir(File(tostring(path)))
end


function YLua:删除文件(path)
  import "java.io.File"
  return File(tostring(path)).delete()
end

function YLua:写入文件(路径,内容)
  import "java.io.File"
  local f=File(tostring(File(tostring(路径)).getParentFile())).mkdirs()
  io.open(tostring(路径),"w"):write(tostring(内容)):close()
end

function YLua:读取文件(路径)
  return io.open(路径):read("*a")
end

function YLua:追加写入(路径,内容)
  io.open(tostring(路径),"a+"):write(tostring(内容)):close()
end

function YLua:替换文件字符串(路径,旧,新)
  路径=tostring(路径)
  内容=io.open(路径):read("*a")
  return io.open(路径,"w+"):write(tostring(内容:gsub(旧,新))):close()
end

function YLua:是WiFi网络()
  wifi = activity.Context.getSystemService(Context.WIFI_SERVICE)
  wi = wifi.isWifiEnabled()
  if wi==true then
    connManager = activity.getSystemService(Context.CONNECTIVITY_SERVICE)
    mWifi = connManager.getNetworkInfo(ConnectivityManager.TYPE_WIFI)
    if tostring(mWifi):find("none)") then
      return false
     else
      return true
    end
   else
    return false
  end
end

function YLua:有网络()
  return activity.getApplicationContext().getSystemService(Context.CONNECTIVITY_SERVICE).getActiveNetworkInfo()
end


function YLua:是数据网络()
  manager = activity.getSystemService(Context.CONNECTIVITY_SERVICE);
  gprs = manager.getNetworkInfo(ConnectivityManager.TYPE_MOBILE).getState();
  if tostring(gprs)== "CONNECTED" then
    return true
   else
    return false
  end
end

function YLua:安装应用(路径)
  import "android.content.Intent"
  import "android.net.Uri"
  intent = Intent(Intent.ACTION_VIEW)
  intent.setDataAndType(Uri.parse("file://"..路径), "application/vnd.android.package-archive")
  intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
  activity.startActivity(intent)
end

function YLua:返回桌面()
  activity.moveTaskToBack(true)
end

function YLua:隐藏状态栏()
  activity.getWindow().setFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN, WindowManager.LayoutParams.FLAG_FULLSCREEN)
end

function YLua:设置状态栏颜色(a)
  activity.getWindow().addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS).setStatusBarColor(a)
end

function YLua:设置标题栏颜色(a)
  import "android.graphics.drawable.ColorDrawable"
  activity.ActionBar.setBackgroundDrawable(ColorDrawable(a))
end

function YLua:显示标题栏()
  activity.ActionBar.show()
end

function YLua:隐藏标题栏()
  activity.ActionBar.hide()
end

function YLua:竖屏()
  activity.setRequestedOrientation(1)
end

function YLua:横屏()
  activity.setRequestedOrientation(0)
end

function YLua:随机数(a,b)
  return math.random(a,b)
end

function YLua:获取文件大小(文件路径)
  import "android.text.format.Formatter"
  return Formatter.formatFileSize(activity,文件路径.length())
end

function YLua:调用系统打开文件(path)
  import "android.webkit.MimeTypeMap"
  import "android.content.Intent"
  import "android.net.Uri"
  import "java.io.File"
  FileName=tostring(File(path).Name)
  ExtensionName=FileName:match(".+%.(%w+)$")
  Mime=MimeTypeMap.getSingleton().getMimeTypeFromExtension(ExtensionName)
  if Mime then
    intent = Intent();
    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
    intent.setAction(Intent.ACTION_VIEW);
    intent.setDataAndType(Uri.fromFile(File(path)), Mime);
    activity.startActivity(intent);
   else
    print("找不到可以用来打开此文件的程序")
  end
end

function YLua:判断数组中值是否存在(字符串,二维表)
  local 临时表={}
  for key,value in pairs(二维表) do
    临时表[value] = true
  end
  if 临时表[字符串] then
    return true;
   else
    return false
  end
end

function YLua:取文件后缀(文件名)
  return 文件名:match(".+%.(%w+)$")
end

function YLua:取文件名称(文件名)
  return 文件名:match("(.+)%.%w+$")
end

function YLua:取文件完整名称(文件名)
  return 文件名:match(".+%/(.+)$")
end

function YLua:提示(内容)
  Toast.makeText(activity, 内容,Toast.LENGTH_SHORT).show()
end

function YLua:分享文字(内容)
  import "android.content.Intent"
  local intent=Intent(Intent.ACTION_SEND);
  intent.setType("text/plain");
  intent.putExtra(Intent.EXTRA_SUBJECT, "分享");
  intent.putExtra(Intent.EXTRA_TEXT, tostring(内容));
  intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
  activity.startActivity(Intent.createChooser(intent,"分享到:"));
end

function YLua:重启应用()
  import "android.content.Intent"
  local intent = activity.getPackageManager().getLaunchIntentForPackage(activity.getPackageName());
  intent.addFlags(Intent.FLAG_ACTIVITY_CLEAR_TOP);
  activity.startActivity(intent);
end

function YLua:安装应用(安装包路径)
  import "android.content.Intent"
  import "android.net.Uri"
  intent = Intent(Intent.ACTION_VIEW)
  intent.setDataAndType(Uri.parse("file://"..安装包路径), "application/vnd.android.package-archive")
  intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
  activity.startActivity(intent)
