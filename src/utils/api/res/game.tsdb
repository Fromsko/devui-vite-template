import "android.database.sqlite.SQLiteDatabase"
import "android.content.ContentValues"

--数据库路径
数据库路径=this.getLuaDir() .. "/new.db"

--链接数据库，返回句柄
db=SQLiteDatabase.openOrCreateDatabase(数据库路径,nil);

--创建数据表
语句="create table test(_id integer primary key autoincrement, title text, message varchar(20))"
--db.execSQL(语句)

--添加数据
contentValues = ContentValues();
contentValues.put("title","标题");
contentValues.put("message", "内容");
db.insert("test",nil,contentValues);

--查询数据
c=db.rawQuery("select * from test",nil);
while (c.moveToNext()) do
  _id = c.getInt(c.getColumnIndex("_id"));
  title = c.getString(c.getColumnIndex("title"));
  content = c.getString(c.getColumnIndex("message"));
  print(_id,title,content)
end

--更新数据
contentValues = ContentValues();
contentValues.put("title", "更新标题");
contentValues.put("message", "更新内容");
print(db.update("test", contentValues, "_id = ?", {"2"}));

--删除数据
db.delete("test","_id = ?",{"1"})

--关闭链接
db.close();
