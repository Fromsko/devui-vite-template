《《调用系统下载》》
《《import "android.content.Context"
import "android.net.Uri"--导入库
--@小菜鸟

downloadManager=activity.getSystemService(Context.DOWNLOAD_SERVICE);
url=Uri.parse("http://小菜鸟.apk"); --下载直链
request=DownloadManager.Request(url);
request.setAllowedNetworkTypes(DownloadManager.Request.NETWORK_MOBILE|DownloadManager.Request.NETWORK_WIFI);--wifi，移动网络(数据流量)都可以下载
