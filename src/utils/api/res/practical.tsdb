《《import"Layout_of_packaging_function_library"


--使用方法:

{
 ScrollView,--纵向滑动控件
 layout_width="fill",--布局宽度
 layout_height="fill",--布局高度
 overScrollMode=View.OVER_SCROLL_NEVER,--隐藏圆弧阴影
 verticalScrollBarEnabled=false,--隐藏纵向滑条
 {
  LinearLayout,--线性布局
  orientation="vertical",--布局方向
  -- orientation=横;
  -- layout_width=罢,--布局宽度
  -- orientation="horizontal",--水平方向
  layout_height="fill",--布局高度
  纽扣控件(ID,"300dp","300dp");
  纽扣控件(ID,"300dp","300dp");
  纽扣控件(ID,"300dp","300dp");
  纽扣控件(ID,"300dp","300dp");
  纽扣控件(ID,"300dp","300dp");
  浏览器控件(ID,宽,高,"https://support.qq.com/embed/phone/312401?",UA,JS,背景);
  卡片圆角布局();
  按钮控件();
  --纽扣控件(宽,高,纽扣名称,背景,填充);
  --纽扣控件("300dp","300dp");
  -- 纽扣控件("300dp","300dp");
  -- 纽扣控件("300dp","300dp");
  -- 纽扣控件("300dp","300dp");
  卡片控件布局("xiuluo1","浏览器","多个引擎搜索","icon.png"),

 };--线性布局结束!

};--纵向滑动控件结束





function 纽扣控件(ID,宽,高,纽扣名称,背景,填充,气泡提示,空显示)
 return{
  Button,--纽扣控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  padding=填充,--布局填充
  error=气泡提示,--气泡提示
  text=纽扣名称,--文本内容
  hint=空显示--内容为空时显示
 };
end

function 帧布局(ID,宽,高,背景)
 return{
  FrameLayout,--帧布局
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
 };--帧布局结束
end

function 相对布局(ID,宽,高,背景)
 return {
  RelativeLayout,--相对布局
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
 };--相对布局结束
end



function 绝对布局(ID,宽,高,背景)
 return {
  AbsoluteLayout,--绝对布局
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
 };--绝对布局结束
end

function 表格布局(ID,宽,高,背景)
 return {
  TableLayout,--表格布局
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
 };--表格布局结束
end

function 文本框控件(ID,宽,高,内容,大小,颜色,背景,空显示,气泡提示)
 return {
  TextView,--文本框控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  text=内容,--文本内容
  textSize=大小,--文本大小
  textColor=颜色,--文本颜色
  hint=空显示,--内容为空时显示
  error=气泡提示,--气泡提示
  --singleLine=true,--禁止换行输入
 };
end



function 图片框控件(ID,宽,高,图片,背景)
 return {
  ImageView,--图片框控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  src=图片,--视图路径
 };
end




function 圆形图片控件(ID,宽,高,图片,背景)
 return {
  CircleImageView,--圆形图片控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  src=图片,--视图路径
 };
end



function 卡片框控件(ID,宽,高,背景,提升,卡片色,圆角)
 return {
  CardView,--卡片框控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  cardElevation=提升,--卡片提升
  cardBackgroundColor=卡片背景色,--卡片背景色
  radius=圆角,--圆角半径
 };--卡片框控件结束
end


function 编辑框控件(ID,宽,高,内容,大小,背景,空显示,气泡提示)
 return {
  EditText,--编辑框控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  text=内容,--文本内容
  textSize=大小,--文本大小
  hint=空显示,--内容为空时显示
  error=气泡提示,--气泡提示
  --singleLine=true,--禁止换行输入
 };
end



function 浏览器控件(ID,宽,高,url,UA,JS,背景)
 return {
  LuaWebView,--浏览器控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  UA=ua,
  JS=js,
  url=url,
 };
end



function 视频控件(ID,宽,高,背景)
 return {
  VideoView,--视频控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
 };--视频控件
end


function 水平分割线(ID,背景)
 return {
  TextView,--水平分割线
  layout_width="fill",--布局宽度
  layout_height="1px",--布局高度
  layout_gravity="center",--重力居中
  id=ID,--控件ID
  background=背景,--布局背景
 };
end


function 垂直分割线(ID,背景)
 return {
  TextView,--垂直分割线
  layout_width="1px",--布局宽度
  layout_height="fill",--布局高度
  layout_gravity="center",--重力居中
  id=ID,--控件ID
  background=背景,--布局背景
 };
end


function 复选框控件(ID,宽,高,内容,背景,选中)
 return {
  CheckBox,--复选框控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
  text=内容,--文本内容
  checked=选中,--是否选中
 };
end


function 开关控件(ID,最小宽度,空白距离,内容,大小,颜色,开启时文字,关闭时文字)
 return {
  Switch,--开关控件
  switchMinWidth=最小宽度,--开关最小宽度
  switchPadding=空白距离,--设置开关与文字的空白距离
  text=内容,--文本内容
  textSize=大小,--文本大小
  textColor=颜色,--文本颜色
  textOff=开启时文字,--设置开关checked的文字
  textOn=关闭时文字,--设置开关关闭时的文字  
  showText=true,--设置是否显示开关上的文字（API21及以上）
  id=ID,--控件ID
 };
end

function Lua编辑控件(ID,宽,高,背景,重力分配)
 return {
  LuaEditor,--lua编辑框控件
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  layout_weight=重力分配,--重力分配
  background=背景,--布局背景
  id=ID,--控件ID
 };
end

function 图片按钮控件(ID,宽,高,图片,背景)
 return {
  ImageButton,--图片按钮控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  src=图片,--视图路径
 };
end


function 按钮控件(ID,宽,高,背景)
 return {
  ToggleButton,--按钮控件
  id=ID,--控件ID
  layout_width=宽,--布局宽度
  layout_height=高,--布局高度
  background=背景,--布局背景
 };
end

function 卡片控件布局(控件,圆角,文本1,文本2,图标)
 return {
  CardView,--卡片框控件
  layout_width="fill",--布局宽度
  layout_height="60dp",--布局高度
  layout_margin="5dp",--布局边距
  cardElevation="2dp",--卡片提升
  radius=圆角;
  {
   LinearLayout,--线性布局
   orientation="horizontal",--水平方向
   layout_width="fill",--布局宽度
   layout_height="fill",--布局高度
   gravity="center",--重力居中
   id=控件,--控件ID
   {
    LinearLayout,--线性布局
    layout_weight="1",--重力分配
    orientation="vertical",--布局方向
    layout_width="fill",--布局宽度
    layout_height="fill",--布局高度
    gravity="center",--重力居中
    {
     TextView,--文本框控件
     gravity='center';--重力属性
     text=文本1,--文本内容
     textSize="13sp",--文本大小
     textColor="#fffde48a",--文本颜色
    },
    {
     TextView,--文本框控件
     gravity='center';--重力属性
     text=文本2,--文本内容
     textSize="11sp",--文本大小
     textColor="#fffde48a",--文本颜色
    },
   },--线性布局 结束
   {
    TextView,--垂直分割线
    layout_width="2dp",--布局宽度
    layout_height="fill",--布局高度
    layout_gravity="center",--独立重力居中
    backgroundColor="#fffde48a",--背景色
   },
   {
    ImageView,--图片框控件
    layout_width="56dp",--布局宽度
    layout_height="36dp",--布局高度
    src=图标,--视图路径
    --colorFilter="#333333",--图片颜色
   },
  },--线性布局 结束
 }--卡片框控件 结束
end



