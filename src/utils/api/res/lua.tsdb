    end)
   else
    local 桌面快捷方式=Intent("com.android.launcher.action.INSTALL_SHORTCUT")
    桌面快捷方式.putExtra("android.intent.extra.shortcut.NAME",name)
    桌面快捷方式.putExtra("android.intent.extra.shortcut.INTENT",intent)
    桌面快捷方式.putExtra("duplicate",0)
    桌面快捷方式.putExtra("android.intent.extra.shortcut.ICON",bit)
    activity.sendBroadcast(桌面快捷方式)
