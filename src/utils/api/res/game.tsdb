《《游戏实例：井字棋》》
《《require "import"
import "android.app.*"
import "android.os.*"
import "android.widget.*"
import "android.view.*"
import "android.graphics.Color"
import "android.graphics.PorterDuff"
import "android.graphics.Paint"


layout=--全屏框架
{
  LinearLayout;--线性控件
  orientation='vertical';--布局方向
  layout_width='fill';--布局宽度
  layout_height='fill';--布局高度
  gravity='center';--控件内容的重力方向
  {
    GridView,
    numColumns=3,
    layout_height='100%w',
    layout_width='100%w',
    id="grid",
  },
}
activity.setContentView(loadlayout(layout))


import "android.graphics.Paint"
import "com.androlua.LuaDrawable"

w=activity.width

--第一版，待完善

item={
  TextView,
  layout_width=w/3,
  layout_height=w/3,
  TextSize="50",
  Gravity="center",
  id="tv",
}

data={}
adp=LuaAdapter(activity,data,item)
grid.setAdapter(adp)

for i=1,9 do
  table.insert(data,{tv=""})
end

--画个UI框
myLuaDrawable=LuaDrawable(function(mCanvas,mPaint,mDrawable)

  mPaint1 = Paint();
  mPaint1.setStrokeWidth(20)
  mPaint1.setAntiAlias(true)
  mPaint1.setStyle(Paint.Style.STROKE)
  mPaint1.setColor(0x88000000)

  mCanvas.drawLine(0,w/3,w,w/3,mPaint1)
  mCanvas.drawLine(0,w*2/3,w,w*2/3,mPaint1)
  mCanvas.drawLine(w/3,0,w/3,w,mPaint1)
  mCanvas.drawLine(w*2/3,0,w*2/3,w,mPaint1)

end)

grid.background=myLuaDrawable

a=true

grid.onItemClick=function(l,v,p,i)

  --轮流下棋的逻辑
  if v.Text=="" then

    if a==true then
      v.Text="✔"
      a=false
     else
      v.Text="✘"
      a=true
    end
   else
    print("这里下过了,不能再下了哦")
  end

  function 判断三棋连珠(x,y,z)

    if x==y and y==z and x==z then

      if x=="" and y=="" and z=="" then

       elseif x=="✔" and y=="✔" and z=="✔" then
        print("✔胜利,游戏结束")
       elseif x=="✘" and y=="✘" and z=="✘" then
        print("✘胜利,游戏结束")
      end
      --return true
    end
    --return false
  end

  --判断横竖是否相连
  for i=0,8 do

    if i%3 == 0 then
      x=grid.getChildAt(i)
      y=grid.getChildAt(i+1)
      z=grid.getChildAt(i+2)
      判断三棋连珠(x.Text,y.Text,z.Text)
    end

    if i<=2 then
      x=grid.getChildAt(i)
      y=grid.getChildAt(i+3)
      z=grid.getChildAt(i+6)
      判断三棋连珠(x.Text,y.Text,z.Text)
    end
  end

  --判断两条交叉斜线是否相连
  x=grid.getChildAt(0)
  y=grid.getChildAt(4)
  z=grid.getChildAt(8)
  判断三棋连珠(x.Text,y.Text,z.Text)

  x=grid.getChildAt(2)
  y=grid.getChildAt(4)
  z=grid.getChildAt(6)
  判断三棋连珠(x.Text,y.Text,z.Text)
end
》》





《《游戏实例：贪吃蛇》》
《《require "import"
import "android.app.*"
import "android.os.*"
import "android.widget.*"
import "android.view.*"
import "android.graphics.Color"
import "android.graphics.PorterDuff"
import "android.graphics.Paint"
--构建布局
layout={
  LinearLayout;--线性控件
  orientation='vertical';--布局方向
  layout_width='fill';--布局宽度
  layout_height='fill';--布局高度
  gravity='center';--控件内容的重力方向
  {
    SurfaceView;
    id="sureface";
    layout_width='100%w';
    layout_height='100%w';
  };
  {
    FrameLayout;
    {
      Button;
      text="↑";
      onClick="up";
      layout_gravity="center";
    };
    layout_width="fill";
  };
  {
    FrameLayout;
    {
      LinearLayout;
      {
        Button;
        text="←";
        onClick="left";
      };
      {
        Button;
        text="↓";
        onClick="down";
      };
      {
        Button;
        text="→";
        onClick="right";
      };
      layout_gravity="center";
    };
    layout_width="fill";
  };
};

activity.setContentView(loadlayout(layout))


import 'android.graphics.*'

function random(...)
  math.randomseed(tonumber(string.reverse(os.clock()))*100000)
  return math.random(...)
end


local W=activity.Width
local H=activity.Height
local bmp=Bitmap.createBitmap(W,H,Bitmap.Config.RGB_565)
local g=Canvas(bmp)
local pen=Paint()
local w=W/24
local m=23
local x=1
local y=1
local rect={}
local _rect={}
local n=4
rect[1]=Rect(w,w,w,w)
_rect[1]={x=1,y=1}

function p()
  X= random (0,m)
  Y= random (0,m)
  _Rect=Rect(X*w,Y*w,(X+1)*w-1,(Y+1)*w-1)
end

p()
local f=0
local m_x=0
local m_y=0
function tick()
  g=holder.lockCanvas()

  --如果画布尚未创建
  if not g then
    return
  end

  --如果超过屏幕
  x=x+m_x
  y=y+m_y
  if x>m then
    x=0
   elseif x<0 then
    x=m
   elseif y>m then
    y=0
   elseif y<0 then
    y=m
  end

  --移动蛇体位置
  local rectangle=Rect(x*w,y*w,(x+1)*w-1,(y+1)*w-1)
  table.insert (rect,1,rectangle)
  table.insert (_rect,1,{x=x,y=y})
  rect[n+1]= nil
  _rect[n+1]= nil

  --如果遇到食物
  if x==X and y==Y then
    n=n+1
    p()
    f=f+10
    tm.Interval=math.max(tm.Interval-2,20)
    activity.Title= '得分：' ..f
  end

  --如果遇到自己
  recth=_rect[1]
  for r=5,#rect do
    if recth.x==_rect[r].x and recth.y==_rect[r].y then
      n=r
      rect[n]=nil
      f=0
      activity.Title= '得分：' ..f
     elseif n<r then
      rect[r]=nil
    end
  end

  --绘制蛇和食物
  g.drawColor(0xffffffff)
  for k,rectangle in ipairs (rect) do
    g.drawRect(rectangle,pen)
  end
  g.drawRect(_Rect,pen)
  g.drawLine(0,W,W,W,pen)
  holder.unlockCanvasAndPost(ca)
end

tm=Ticker()
tm.Interval=200
tm.Enabled= true
tm.onTick=tick

function up()
  if st~='d' then
    m_x,m_y=0,-1
    st='u'
  end
end

function down()
  if st~='u' then
    m_x,m_y=0,1
    st='d'
  end
end

function left()
  if st~='r' then
    m_x,m_y=-1,0
    st='l'
  end
end

function right()
  if st~='l' then
    m_x,m_y=1,0
    st='r'
  end
end


callback=SurfaceHolder.Callback{
  surfaceChanged=function(holder,format,width,height)
  end,
  surfaceCreated=function(holder)
    ca=holder.lockCanvas()

    --如果没有启动定时器则启动
    if not tm.isRun() then
      tm.start()
      right()
    end
    holder.unlockCanvasAndPost(ca)
  end,
  surfaceDestroyed=function(holder)
  end
}
holder=sureface.getHolder()
holder.addCallback(callback)

function onStart()
  tm.Enabled=true
end

function onStop()
  tm.Enabled=false
end


