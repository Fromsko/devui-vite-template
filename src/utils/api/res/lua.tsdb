《《最方便的二进制调用》》
《《 --SCP二进制中文函数调用模块(所有框架通用)

--【1】调用二进制中文函数模块包↓
function 二进制执行(二进制路径,二进制开关提示)--中文函数
二进制调用=activity.getLuaDir(二进制路径)--自动获取lua文件的执行路径,只需填二进制在插件的目录路径即可
local Root,exit,numb=os.execute("su")
if Root==true then--判断有root则执行以下命令↓
os.execute("su -c chmod 777 "..二进制调用)--授予777权限
Runtime.getRuntime().exec("su -c "..二进制调用)--执行二进制功能
print(二进制开关提示)
else--没有root则执行以下命令↓
os.execute("chmod 777 "..二进制调用)--授予777权限
Runtime.getRuntime().exec(""..二进制调用)--执行二进制功能
print(二进制开关提示)
end
end
