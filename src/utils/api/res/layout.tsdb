textColor='';--文本颜色
textSize='';--文本大小
Format24Hour='';
Format12Hour='';
--后两个的属性
--yyyy.MM.dd 年.月.日,
--EE 周几,部分手机上会显示星期几
--aa 上午或下午,24小时的时候什么都不会显示,12小时的时候会显示am或者pm部分手机显示的上午或下午
--MMMM.dd 月份.日
};


