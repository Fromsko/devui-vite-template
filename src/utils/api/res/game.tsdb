setContactListener --设置碰撞监听器
  ContactListener{
  add=function( contactPoint)--每当有碰撞会调用此函数添加新的接触点
  end,
  persist=function( contactPoint)--持续碰撞调用此函数
  end,
  remove=function( contactPoint)--脱离碰撞调用此函
  end,
  result=function( contactResult)--	发生碰撞（有新的接触点被监听到）会调用此函数 持续碰撞时也会调用此函数
  end,
  }
setContactFilter --设置碰撞过滤器
  ContactFilter{
    shouldCollide=function(Shape shape, Shape shape2)
      end
  }
setDebugDraw() --设置调试绘图
createBody() --创建新对象
destroyBody() --删除对象
createJoint --创建关节
destroyJoint --删除关节
step(f,i)--f 时间步1/60 i 迭代次数10
postStep(f,i)--后步骤
registerPostStep(Steppable)--注册后步骤
unregisterPostStep(Steppable) --销毁后步骤
refilter(Shape shape) --参照过滤器--形状过滤器
setWarmStarting(b) --设置热启动
setPositionCorrection(b)--设置位置校正
setContinuousPhysics(b)--设置连续物理
validate() 
getProxyCount() --获取代理数量
getPairCount() --获取配对数量
getWorldAABB() v--获取世界边界
inRange(AABB) --是否在范围内
solve(TimeStep) --设置线程
solveTOI(TimeStep)
drawShape(Shape,XForm,Color3f,b)--绘制形状
drawJoint(Joint) -+绘制关节
drawDebugData() --绘制debug

contactPoint --类
    public float friction;--摩擦力
    public ContactID id = new ContactID();
    public Vec2 normal = new Vec2();
    public Vec2 position = new Vec2();
    public float restitution;--复原
    public float separation;--分离
    public Shape shape1;--获取碰撞1外形
    public Shape shape2;--获取碰撞2外形
    public Vec2 velocity;--速度
