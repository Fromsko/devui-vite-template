data=[500,1000,--点击坐标 建议初始一个位置
nil,0,--滑动坐标
0,0,--松开坐标
0,0,--mCanvas画布坐标
1,1,--mCanvas画布方法缩小
5,--圈线粗细
150,--摇杆外圈半径
50,--摇杆大小
0,0,--按钮在外圈坐标 --14.15
170,--摇杆最外圈
2,--设置模式 1 摇杆在松手后回归指定位置 2 摇杆停在松手位置 3 摇杆停在点击位置
300,500,--摇杆回归指定位置 18 19
nil,--只能与模式1 2混合用 存在则 只有点击到摇杆内部才能启动摇杆 不存在 则摇杆跟随且直接启动
]

图层.setBackground(LuaDrawable(function(mCanvas,mPaint,mDrawable)--框选绘制
  mPaint=Paint();
  mPaint.setColor(0xff7e5cf8)--设置画笔
  mPaint.setStyle(Paint.Style.STROKE);--画线画法
  mPaint.setStrokeWidth(data[11])--设置粗细

  --mPaint.setAntiAlias(true)--抗锯齿
  --mPaint.setDither(true)--: 设定是否使用图像抖动处理，会使绘制出来的图片颜色更加平滑和饱满，图像更加清晰
  画笔=Paint();
  画笔.setColor(0xffff0000)--设置画笔


  return function(mCanvas)
    --Thread.sleep(16)
    mCanvas.translate(data[7],data[8])--画布偏移
    mCanvas.scale(data[9],data[10])--画布扩缩


    if data[3] then--滑动后绘制
      mCanvas.drawCircle(data[14],data[15],data[13],mPaint)--摇杆按钮
      mCanvas.drawLine(data[1],data[2],data[14],data[15],mPaint)--摇杆连线
      mCanvas.drawCircle(data[1],data[2],data[12],mPaint)--摇杆外圈
      mCanvas.drawCircle(data[1],data[2],data[16],mPaint)--摇杆最外圈

     else
      mCanvas.drawCircle(data[1],data[2],data[13],mPaint)--静止摇杆按钮
      mCanvas.drawCircle(data[1],data[2],data[12],mPaint)--摇杆外圈
      mCanvas.drawCircle(data[1],data[2],data[16],mPaint)--摇杆最外圈

    end


    mDrawable.invalidateSelf()--重新画图
  end
end))


底层.onTouch=function(v,event)--手势滑动
  --文字.setText(tostring(event.getAction()))
  if event.getAction()==MotionEvent.ACTION_DOWN then
    if data[20] then--用最外圈判断
      if data[16]-两点间距离(data[1],data[2],event.getRawX(),event.getRawY()) > 0 then--在圈内                     
       else--圈外      
        if data[17]==1 then
          data[1],data[2]=data[18],data[19]
         elseif data[17]==2 then
          data[1],data[2]=event.getRawX(),event.getRawY()         
        end
        return
      end
     else
      data[1] = event.getRawX()
      data[2] = event.getRawY()
    end
    x=event.getRawX()
    y=event.getRawY()
   elseif event.getAction()==261 then--多指点击 262有手撤出
    --获取第二个点击
    ont=math.abs(y-event.getRawY(1))

   elseif event.getAction()==MotionEvent.ACTION_MOVE then--手指有滑动行为


    if event.getPointerCount() > 1 then--多指滑动
      --data[7]=data[7] + (event.getRawX() - x)
      --data[8]=data[8] + (event.getRawY() - y)


     else--单指滑动
      data[3],data[4] = 计算坐标函数(event.getRawX(),event.getRawY(),data[7],data[8],data[9],data[10])
      data[14],data[15] = 计算(data[1],data[2],event.getRawX(),event.getRawY(),data[12])--cos(200,角度,data[1]),sin(200,角度,data[2])
    end
    文字.setText(event.getRawX().."\n".."".."\n".."".."\n".."")

   elseif event.getAction()==MotionEvent.ACTION_UP then--手指抬起
    data[5] = (event.getRawX()-data[7])*(1/data[9])
    data[6] = (event.getRawY()-data[8])*(1/data[10])

    if data[17]==1 then
      data[1],data[2]=data[18],data[19]
     elseif data[17]==2 then
      data[1],data[2]=event.getRawX(),event.getRawY()
     elseif data[17]==3 then
    end

    data[3]=nil--重置滑动判断
  end
  return true
end

function 计算坐标函数(x,y,x2,y2,x3,y3)
  --x,y相对屏幕坐标
  --x2,y2相对屏幕画布偏移坐标
  --x3,y3画布x,y轴放大缩小倍数
  return (x-x2)/x3,(y-y2)/y3
end



function 计算(x,y,x1,y1,斜边)
  local k=(y-y1)/(x-x1)--斜率
  -- local b=y-(x*k)
  local t=math.atan(k)--弧度
  if x1-x >0 then
    x2=斜边*math.cos(t)+x
    y2=斜边*math.sin(t)+y
   else
    x2=x-斜边*math.cos(t)
    y2=y-斜边*math.sin(t)
  end
  return x2,y2
end

function 两点间距离(x,y,x1,y1)
  return math.sqrt( math.pow((x-x1),2)+math.pow((y-y1),2))
end》》







