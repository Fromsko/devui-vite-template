      activity.getSystemService("shortcut").requestPinShortcut(ShortcutInfo.Builder(activity,name).setIcon(Icon.createWithResource(activity,R.drawable.icon)).setShortLabel(name).setIntent(intent).build(),nil)
      提示6"添加快捷方式成功"
