--快递单号改变
kuaidi_input.addTextChangedListener{
  onTextChanged = function(text, start, before, count)
    if kuaidi_input.text == "" then return end --无输入
    Http.get("https://api.vvhan.com/api/kuaidi?hao="..urlEncode(kuaidi_input.text), nil, nil, nil, function(code, content, cookie, header)
      if code ~= 200 then
        return Toast.makeText(activity, "get错误\ncode:"..code.."\ncontent:"..content,Toast.LENGTH_SHORT).show()
      end
      local json = cjson.decode(content)
      if not json.success then
        return Toast.makeText(activity, "服务器错误\ncontent:"..content,Toast.LENGTH_SHORT).show()
      end
      kuaidi_name_output.text = cjson.encode(json.name)
      kuaidi_type_output.text = cjson.encode(json.type)
      kuaidi_info_output.text = string.gsub(
      string.gsub(
      string.gsub(cjson.encode(json.info), "{", "{\n")
      , "}", "\n}\n")
      , ",", ",\n")
    end)
  end
}

