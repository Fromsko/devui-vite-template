《《color='FF000000'--//去除0x或#后的颜色值

--取r,g,b
local r=utf8.sub(color,3,4)
local g=utf8.sub(color,5,6)
local b=utf8.sub(color,7,8)
function toint(e)--封装函数
  import 'java.lang.Long'
return Long.parseLong(e, 16)
end
grayLevel = toint(r) * 0.299 + toint(g) * 0.587 + toint(b) * 0.114;--RGB 模式转换成 YUV 模式，而 Y 是明亮度（灰阶），因此只需要获得 Y 的值而判断他是否足够亮就可以了
if (grayLevel <= 192) then
  print("暗色") --黑
  else
  print("亮色")--白
