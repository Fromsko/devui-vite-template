local item={
  LinearLayout;
  padding="8";
  orientation='vertical';
  layout_width='match_parent';
  {
    CardView;
    id="card",
    layout_height='50%w';
    layout_width='match_parent';
    radius='5';
    {
      ImageView;
      id="img";
      layout_width='match_parent';
      layout_height='match_parent';
      scaleType='fitXY';
    };
    {
      TextView;
      id="txt";
      Visibility='gone';
    };
