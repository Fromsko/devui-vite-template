--获取风景图
function get_view()
  Http.get("https://api.vvhan.com/api/view?type=json", nil, nil, nil, function(code, content, cookie, header)
    if code ~= 200 then
      return Toast.makeText(activity, "get错误\ncode:"..code.."\ncontent:"..content,Toast.LENGTH_SHORT).show()
    end
    local json = cjson.decode(content)
    if not json.success then
      return Toast.makeText(activity, "服务器错误\ncontent:"..content,Toast.LENGTH_SHORT).show()
    end
    view_output.loadUrl("data:text/html,<body style='margin:0;'><img src='"..json.imgurl.."' style='width:256px; height:160px;' /></body>")
  end)
end
--get_view()
view_next.onClick = get_view --下一张
view_download.onClick = function --下载
  local url = string.match(view_output.getUrl(), "src='(.-)'")
  local addr = "/sdcard/view("..os.date("%Y-%m-%d %H:%M:%S")..").png"
  Http.download(url, addr, nil, nil, function
    print("已下载至"..addr)
  end)
end

