zt={["10"]="【己开启】",["11"]="【开启中】",["12"]="【己关闭】",["13"]="【关闭中】",["14"]="【未知。。】"}

--获取蓝牙适配器
bt=BluetoothAdapter.getDefaultAdapter()


--判断蓝牙是否打开
if bt.isEnabled() then 
  bnock=true
  bn1.setText("关闭蓝牙")   
  else 
  bnock=false
  bn1.setText("开启蓝牙")  
end

--打开蓝牙
function openbt()
  bt.enable()
end

--扫描
function listbt()
  --判断是否在扫描中
   local nn=tostring(bt.getBondedDevices())
  --处理地址  特么的总感觉那不对，改截取字符
--  local tx=string.gsub(nn,"%[","")
--  local ty=string.gsub(tx,"%]","")
    local ty=string.sub(nn,2,18)
   if string.len(ty) > 0 then
     bt.cancelDiscovery()
     bbtxt.setText("己获取配对数据")
     sao.setText("开启扫描")
     en1.setText(ty)
   end
   
end

--关闭扫描
function closesaomiao()
  bt.cancelDiscovery()
 end

--关闭蓝牙
function closebt()
  bt.disable()
end


--这个不解释了
function msg(text)
  print(text)
end


function statebt()
  --获取state状态 返回int值
  local xx=bt.getState()
  --这里可以不用tostring,改下链表既可
  local yy=tostring(xx)
  return zt[yy]
end


