Bubbles1.getConfigBuilder()
.min(0)--最小值
.max(5)--最大值
.progress(2)--设置当前进度
.sectionCount(5)--设置绘制几个点
.trackColor(0xFF757575)--设置轨道的颜色
.secondTrackColor(0xFF3F51B5)--设置进度条色
.thumbColor(0xFF3F51B5)--设置拖柄的颜色
.showSectionText()--显示部分文字

.sectionTextColor(0xFF9E9E9E)--拖动条下面文字的默认颜色
.sectionTextSize(18)

.showThumbText()--设置突出显示下方文字
.thumbTextColor(0xFF616161)--突出显示字体的颜色
.thumbTextSize(18)--突出显示文字大小

.bubbleColor(0xFF3F51B5)--气泡的颜色
.bubbleTextSize(18)--气泡的字体大小

.showSectionMark()--显示标记
.seekStepSection()--设置滑块只移动到每个点上，不经过路径
.touchToSeek()--设置从触摸位置开始否则将必须点击拖块拖动
.sectionTextPosition(BubbleSeekBar.TextPosition.BELOW_SECTION_MARK)--设置标记下方文字显示方式
.build();--创建


Bubbles2.getConfigBuilder()
.min(0)
.max(5)
.progress(2)
.sectionCount(5)
.trackColor(0xFF757575)
.secondTrackColor(0xFFFF5722)
.thumbColor(0xFFFF5722)
.showSectionText()
.sectionTextColor(0xFF9E9E9E)
.sectionTextSize(18)
