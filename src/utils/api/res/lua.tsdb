----string.dump自检和loadstring自检

local _mirror_string_dump_c_FUNC=string.dump
local _mirror_loadstring_c_FUNC=loadstring
local _proxy_string_dump_c_FUMC
loadstring=function(code,...)
  print(code)
  return _mirror_loadstring_c_FUNC(code,...)
end
string.dump=function(func,nodebug)
  if nodebug~=true then nodebug=false end
  if func==loadstring or func==_proxy_string_dump_c_FUMC then
    error("unable to dump given function",1)
   else
    return _mirror_string_dump_c_FUNC(func,nodebug)
  end
end
_proxy_string_dump_c_FUMC=string.dump
print(string.dump(function()print(1)end))
pcall(function()
  print(string.dump(loadstring))
  print("string.dump test loadstring run here.")
end)
pcall(function()
  print(string.dump(string.dump))
  print("string.dump test string.dump run here.")
end)
loadstring("print(111)")()


local _mirror_string_dump_c_FUNC=string.dump
local _mirror_loadstring_c_FUNC=loadstring
loadstring=function(code,...)
  print(code)
  return _mirror_loadstring_c_FUNC(code,...)
end
string.dump=function(func,nodebug)
  if nodebug~=true then nodebug=false end
  if func==loadstring then
    error("unable to dump given function",1)
   else
    return _mirror_string_dump_c_FUNC(func,nodebug)
  end
end
print(string.dump(function()print(1)end))
pcall(function()
  print(string.dump(loadstring))
  print("string.dump test loadstring run here.")
end)
loadstring("print(111)")()



 -----------------------------------------------------------------------------
    --第三方属性检查完毕
    -----------------------------------------------------------------------------


XLInterceptionTool={
  ["load"]=function(code,...)
    print("load:",code)
  end;
  ["loadstring"]=function(code,...)
    print("loadstring:",code)
  end;
  ["loadfile"]=function(filepath,...)
    print("loadfile:",filepath)
  end;
  ["dofile"]=function(filepath,...)
    print("dofile:",filepath)
  end;
  ["string.dump"]=function(func,...)
    print("string.dump:",func)
  end;
}
--lua的各种加载api
local _mirror_string_dump_c_FUNC=string.dump
local _mirror_loadstring_c_FUNC=loadstring
local _mirror_load_c_FUNC=load
local _mirror_loadfile_c_FUNC=loadfile
local _mirror_dofile_c_FUNC=dofile
local _proxy_string_dump_c_FUMC
loadstring=function(...)
  XLInterceptionTool["loadstring"](...)
  return _mirror_loadstring_c_FUNC(...)
end
load=function(...)
  XLInterceptionTool["load"](...)
  return _mirror_load_c_FUNC(...)
end
loadfile=function(...)
  XLInterceptionTool["loadfile"](...)
  return _mirror_loadfile_c_FUNC(...)
end
dofile=function(...)
  XLInterceptionTool["dofile"](...)
  return _mirror_dofile_c_FUNC(...)
end
string.dump=function(func,nodebug)
  XLInterceptionTool["string.dump"](func,nodebug)
  if nodebug~=true then nodebug=false end
  if (func==loadstring or
    func==load or
    func==loadfile or
    func==dofile or
    func==_mirror_activity_doString_java_METHOD or
    func==_proxy_string_dump_c_FUMC) then
    error("unable to dump given function",1)
   else
    return _mirror_string_dump_c_FUNC(func,nodebug)
  end
end
_proxy_string_dump_c_FUMC=string.dump


