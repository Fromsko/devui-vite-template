function 图片旋转(角度)
  import "android.graphics.Matrix"
  import "android.graphics.Bitmap"
  a = Matrix()
  a.postRotate(角度)
  return Bitmap.createBitmap(bit,0,0,bit.getWidth(),bit.getHeight(),a,true)
end


