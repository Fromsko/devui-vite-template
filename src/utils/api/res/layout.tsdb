    cardview3.setVisibility(View.VISIBLE)
    cardview4.setVisibility(View.VISIBLE)

    cardview1.startAnimation(ScaleAnimation(0.0, 1.0, 0.0, 1.0,1, 0.5, 1, 0.5).setDuration(200))
