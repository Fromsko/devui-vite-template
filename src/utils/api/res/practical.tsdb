function dp2px(dpValue)
  local scale = activity.getResources().getDisplayMetrics().scaledDensity
  return dpValue * scale + 0.5
end



import "android.animation.AnimatorSet"
import "android.animation.ObjectAnimator"
import "android.view.animation.DecelerateInterpolator"

local animatorSet = AnimatorSet()
local tscaleX = ObjectAnimator.ofFloat(playButton, "scaleX", {playButton.scaleX, 1.45})
local tscaleY = ObjectAnimator.ofFloat(playButton, "scaleY", {playButton.scaleY, 1.45})
local tscaleH = ObjectAnimator.ofFloat(playButton, "translationY", {playButton.y,playButton.y-dp2px(56)})

animatorSet.setDuration(350)
animatorSet.setInterpolator(DecelerateInterpolator());
animatorSet.play(tscaleY)
.with(tscaleX).after(tscaleH)

animatorSet.addListener {
  onAnimationEnd=function()

    local anim1=ObjectAnimator.ofArgb(playAnim, "backgroundColor", {
    0xFFFA7298,0xffffffff})
    .setDuration(50)

    local anim2=ObjectAnimator.ofFloat(playAnim, "alpha", {
    playAnim.alpha,0})
    .setDuration(50)



    local anim0=ViewAnimationUtils.createCircularReveal(playAnim,
    playButton.x+dp2px(56/2),
    playButton.y+dp2px(56/2),
    dp2px(56*1.45/2),activity.width*0.99)
    .setInterpolator(DecelerateInterpolator())
    .setDuration(500)
    .addListener {
      onAnimationStart=function()
        playButton.visibility=8
        playAnim.visibility=0
      end,
      onAnimationEnd=function()
        local animatorSet = AnimatorSet()

        animatorSet.setDuration(150)
        animatorSet.setInterpolator(DecelerateInterpolator());
        animatorSet.play(anim1).with(anim2)
        
        animatorSet.start()
      end
    }.start()

  end
}

task(300,lambda _:animatorSet.start())》》























