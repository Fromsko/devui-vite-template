《《zipr：超级zip操作封装库》》
《《
--引入封装库
import "zipr"


--解压zip：zip路径, 解压到的路径, 密码(nil表示不设密码)   返回 true/false
local re = zipr.unzip(p, out)  --没有密码
local re = zipr.unzip(p, out, pass)
if re then
print("解压成功")
end


--压缩zip：要压缩的路径, 压缩到的路径(不包含文件名), 密码(nil表示不设密码)   返回 true/false
local re = zipr.zip(p, out) --不设密码
local re = zipr.zip(p, out, pass)
if re then
print("压缩成功")
end


--解压单文件：要解压的zip,要解压的文件名,解压到的文件夹,密码   返回 true/false
local re = zipr.unzips(p, n, out) --没有密码
local re = zipr.unzips(p, n, out, pass)
if re then
print("单文件解压成功")
end


--zip是否有密码：zip压缩包路径  返回 true/false
local re = zipr.haspass(p)
if re then
print("这个zip文件有密码")
end


--zip文件列表：zip压缩包路径  返回table
local re = zipr.list(p)
print(dump(re))


 --获取zip内文件大小：zip路径，文件路径  返回 int
local re = zipr.size(p, n)
print(re)


--压缩文件(自定义zip名称)：需要压缩的路径，压缩到的路径，zip文件名称(xx.zip)   返回true/false
local re = zipr.zipn(input, out, name)
if re then
print("压缩成功")
end


--获取zip文件内容：zip路径，文件路径，编码方式(默认 utf-8 )  返回字符串
local re = zipr.read(p,n,code)
print(re)


