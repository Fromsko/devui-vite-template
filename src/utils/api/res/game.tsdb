--原物理传感器改造成重力球，倾斜角度越大，小球加速度越大


--dp转px--
function dp2px(dpValue)
  local scale = this.getResources().getDisplayMetrics().density
  return (dpValue * scale)
end
R=dp2px(30)
W=activity.getWidth()
H=activity.getHeight()
xc=W/2-R--球位于中心时左上角x坐标
yc=H/2-R--球位于中心时左上角y坐标



activity.setContentView(loadlayout({
  LinearLayout;
  id="nio";
  orientation="vertical";
  {
    RelativeLayout;
    layout_width="fill";
    background="#FFFFFF";
    layout_height="fill";
    gravity="center";
    id="ht";
    {
      CardView;
      CardElevation="4dp";
      radius="30dp";
      layout_width="60dp";
      background="#0090ff";
      layout_height="60dp";
      layout_marginTop="90dp";
      layout_marginLeft="100dp";
      id="ho";
      {
        Button;
        style="?android:attr/buttonBarButtonStyle";
        textColor="#FFFFFF";
        layout_width="fill";
        layout_height="fill";
        text="+";
        textSize="30dp";
        id="hy";
      };
    };
    {
      TextView;
      id="tv",
      gravity="center";
      text=[==[这是一个传感器的物理效果，不是很好，但是...]==];
    };
    {
      TextView;
      layout_marginTop="100dp";
    };
  };
}))

vx=0
vy=0

传感器 = activity.getSystemService(Context.SENSOR_SERVICE)
local 加速度传感器 = 传感器.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)
sensorEventListener=SensorEventListener({
  onSensorChanged=function(event)
    ax = event.values[0]
    ay = event.values[1]
    vx=vx-ax
    vy=vy+ay
    if vx<R-W/2 then
      ho.setX(0)
     elseif vx>W/2-R then
      ho.setX(W-2*R)
     else
      ho.setX(xc+vx)
    end
    if vy<R-H/2 then
      ho.setY(0)
     elseif vy>H/2-R then
      ho.setY(H-2*R)
     else
      ho.setY(yc+vy)
    end
  end,nil
})
传感器.registerListener(sensorEventListener, 加速度传感器, SensorManager.SENSOR_DELAY_NORMAL)


function onDestroy()
  传感器.unregisterListener(sensorEventListener)
end》》






