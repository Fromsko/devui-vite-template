import "android.app.*"
import "android.os.*"
import "android.widget.*"
import "android.view.*"
import "java.io.File"

灰色=0xFFF5F6FA
黑色=0xef000000
白色=0xffffffff
深灰色=0xFFAFB2BF
蓝色=0xff2b9cff
activity.setTheme(android.R.style.Theme_DeviceDefault_Light)
activity.ActionBar.hide()--隐藏标题栏
activity.getWindow().getDecorView().setSystemUiVisibility(View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR);--状态栏亮色
activity.getWindow().setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_PAN);--输入法不影响布局
activity.getWindow().setStatusBarColor(蓝色);--状态栏颜色

function 波纹(控件,颜色)
  import "android.content.res.ColorStateList"
  local attrsArray={android.R.attr.selectableItemBackgroundBorderless}
  local typedArray=activity.obtainStyledAttributes(attrsArray)
  Pretend = activity.Resources.getDrawable(typedArray.getResourceId(0,0))
  Pretend.setColor(ColorStateList(int[0].class{int{}},int{颜色}))
  控件.setBackground(Pretend.setColor(ColorStateList(int[0].class{int{}},int{颜色})))
end

layout=
{
  LinearLayout;
  orientation='vertical';--重力属性
  layout_width='fill';--布局宽度
  layout_height='fill';--布局高度
  background='#FFFFFFFF';--布局背景颜色(或者图片路径)
  {
    CardView;--卡片控件
    layout_gravity='center';--重力属性
    elevation='0';--阴影属性
    layout_width='-1';--卡片宽度
    CardBackgroundColor=蓝色;--卡片背景颜色
    layout_height='56dp';--卡片高度
    radius='0';--卡片圆角
    {
      ImageView;--图片控件
      src='/storage/emulated/0/AndLua/project/Twilight 暮光/ziyuan/fanhui.png';--图片路径
      layout_width='28dp';--图片宽度
      layout_height='28dp';--图片高度
      scaleType='fitXY';--图片显示类型
      layout_gravity='left|center';--子控件在父控件中的对齐方式
      layout_marginLeft='15dp';--布局左距
      colorFilter="#ffffff",--图片颜色
      id="退出";
    };
    {
      TextView;--文本控件
      layout_width='wrap';--文本宽度
      layout_height='30dp';--文本高度
      gravity='center';--重力属性
      textColor=白色;--文字颜色
      text='壁纸大全';--显示的文字
      textSize='18dp';--文字大小
      layout_gravity='left|center';--子控件在父控件中的对齐方式
      layout_marginLeft='60dp';--布局左距
      id="标题";
    };
  };
  {
    GridView;--网格控件
    layout_width='fill';--网格宽度
    layout_height='fill';--网格高度
    Gravity='center';--对齐方式
    NumColumns='2';--列数
    --ColumnWidth='';--每一列的宽度
    --StretchMode='';--缩放
    --HorizontalSpacing='';--两列直接的边距
    --VerticalSpacing='';--两行之间的间距
    id="list";
  };
};
activity.setContentView(loadlayout(layout))--布局视图

退出.onClick=function()
  activity.finish()--关闭当前页面
end

