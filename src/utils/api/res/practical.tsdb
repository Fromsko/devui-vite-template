--print(dump(themecolor))
lexer=LuaLexer(code)
local z=0
local 开始=0
local 结束=0
local s={}
local d={}
while z~=nil do
  z=lexer.advance()
--  print(z,lexer.yytext())
  if tostring(z)=="LCURLY" then
    开始=开始+1
    table.insert(s,lexer.yytext())
    continue
  end
  if tostring(z)=="RCURLY" and 开始==结束+1 then
     结束=结束+1
     table.insert(s,lexer.yytext())
     table.insert(d,table.concat(s))
     table.clear(s)
   elseif tostring(z)=="RCURLY" then
    结束=结束+1
    table.insert(s,lexer.yytext())
    continue
  end

  if 结束<开始 then
    table.insert(s,lexer.yytext())
  end
end

print(table.concat(d,"\n\n"))



