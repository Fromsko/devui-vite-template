.showSectionMark()--显示标记
.seekBySection()
.autoAdjustSectionMark()--自动寻找标记
.sectionTextPosition(BubbleSeekBar.TextPosition.BELOW_SECTION_MARK)
.build();


Bubbles3.getConfigBuilder()
