--[[
捐赠页面 by 原作者幻了个城fly
--]]

require "import"
import "loadlayout"
import "android.app.*"
import "android.os.*"
import "android.widget.*"
import "android.view.*"
import "android.graphics.drawable.BitmapDrawable"
import "android.graphics.Color"
import "android.support.v7.widget.*"
activity.setTheme(android.R.style.Theme_DeviceDefault_Light)--设置md主题
activity.ActionBar.hide()--隐藏顶栏

--背景颜色
color1="#FFFFFFFF"
--标题颜色
color2="#FF000000"
--副标题颜色
color3="#60000000"
--按钮副色
btnColor1="#FF3DA3DF"
--按钮主色
btnColor2="#FF2C7BF2"
--支付宝转账二维码网址
alipayUrl="https://qr.alipay.com/fkx06365tfdm8ixioo7fo86"
--支付宝红包二维码网址
alipayHongbaoUrl="https://i.loli.net/2019/12/06/f2kdDI6yUAiLXgs.png"

--沉浸状态栏
activity.getWindow().addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS).setStatusBarColor(0xffffffff);
if tonumber(Build.VERSION.SDK) >= 23 then
  activity.getWindow().getDecorView().setSystemUiVisibility(View.SYSTEM_UI_FLAG_LIGHT_STATUS_BAR);
end

